FROM registry.access.redhat.com/ubi9-minimal@sha256:bba2b4bbf0ed15cfe7dd72a1e17ae7d2015a141f306b304e1a2785c41400e39c AS build

RUN microdnf install -y gzip tar && microdnf clean all

ADD bin/download-tools.sh .
RUN ./download-tools.sh

FROM registry.access.redhat.com/ubi9-minimal@sha256:bba2b4bbf0ed15cfe7dd72a1e17ae7d2015a141f306b304e1a2785c41400e39c

LABEL org.opencontainers.image.source="https://github.com/johankok/olm-paas-deploy" \
      org.opencontainers.image.description="Getting started with installing opr-paas on a vanilla OpenShift cluster"

COPY --from=build /usr/local/bin/* /usr/local/bin/
